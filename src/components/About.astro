---
import { team, aboutText } from '../data/site';
---

<section class="section" id="quienes-somos">
  <div class="container about">
    <div class="about__copy">
      <p class="eyebrow" data-reveal>Quiénes somos</p>
      <h2 class="h2" data-reveal style="--reveal-i:1">Gravity Team</h2>
      {
        aboutText.map((p, i) => (
          <p class="muted about__p" data-reveal style={`--reveal-i:${i + 2}`}>
            {p}
          </p>
        ))
      }
    </div>

    <div class="about__team">
      {
        team.map((m, i) => (
          <figure class="member surface spot lift" data-reveal="right" style={`--reveal-i:${i}`}>
            <div class="member__photo">
              {m.photo ? (
                <img src={m.photo} alt={m.name} loading="lazy" width="720" height="900" />
              ) : (
                <span class="member__initial" aria-hidden="true">
                  {m.name.charAt(0)}
                </span>
              )}
            </div>
            <figcaption>
              <p class="member__name">{m.name}</p>
              <p class="member__role">{m.role}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(var(--g-space-8), 5vw, var(--g-space-16));
    align-items: start;
  }

  .about__copy {
    display: flex;
    flex-direction: column;
    gap: var(--g-space-4);
  }

  .about__p {
    line-height: var(--g-leading-relaxed);
    text-wrap: pretty;
  }

  .about__team {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--g-space-5);
  }

  .member {
    display: flex;
    flex-direction: column;
    gap: var(--g-space-3);
    margin: 0;
    padding: var(--g-space-4);
    border-radius: var(--g-radius-xl);
  }

  /* Ratio fijo: en el sitio actual las tres fotos tienen tamaños distintos. */
  .member__photo {
    aspect-ratio: 4 / 5;
    border-radius: var(--g-radius-lg);
    overflow: hidden;
    background: var(--g-surface-raised);
    display: grid;
    place-items: center;
  }

  .member__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .member__initial {
    font-family: var(--g-font-display);
    font-size: var(--g-text-4xl);
    font-weight: var(--g-weight-bold);
    color: var(--g-border-strong);
  }

  .member__name {
    font-family: var(--g-font-display);
    font-weight: var(--g-weight-semibold);
    color: var(--g-text-strong);
    line-height: var(--g-leading-snug);
  }

  .member__role {
    font-size: var(--g-text-sm);
    color: var(--g-text-accent);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
