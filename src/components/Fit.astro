---
import { fitYes, fitNo } from '../data/site';

/*
 * Para quién es y para quién no. Descalificar en voz alta hace que el que sí
 * encaja se sienta elegido, y filtra al que no antes de que agende.
 */
---

<section class="section" id="para-quien-es">
  <div class="container container--md">
    <h2 class="h2 center" data-reveal>¿Es para tu clínica?</h2>

    <div class="fit">
      <div class="fit__col fit__col--yes surface spot" data-reveal="left">
        <h3 class="fit__title">Es para vos si…</h3>
        <ul class="fit__list">
          {
            fitYes.map((p, i) => (
              <li data-reveal="left" style={`--reveal-i:${i + 1}`}>
                <svg class="ico ico--yes" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20 6L9 17l-5-5" />
                </svg>
                {p}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="fit__col surface" data-reveal="right">
        <h3 class="fit__title fit__title--no">No es para vos si…</h3>
        <ul class="fit__list">
          {
            fitNo.map((p, i) => (
              <li data-reveal="right" style={`--reveal-i:${i + 1}`}>
                <svg class="ico ico--no" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M18 6L6 18M6 6l12 12" />
                </svg>
                {p}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .fit {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: var(--g-space-6);
    margin-top: var(--g-space-10);
  }

  .fit__col {
    padding: var(--g-space-8);
    border-radius: var(--g-radius-xl);
  }

  .fit__col--yes.surface {
    border-color: var(--g-accent-border);
  }

  .fit__title {
    font-size: var(--g-text-xl);
    color: var(--g-text-strong);
    margin-bottom: var(--g-space-5);
  }

  .fit__title--no {
    color: var(--g-text-subtle);
  }

  .fit__list {
    display: flex;
    flex-direction: column;
    gap: var(--g-space-4);
    list-style: none;
    padding: 0;
  }

  .fit__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--g-space-3);
    line-height: var(--g-leading-normal);
    text-wrap: pretty;
  }

  .fit__col--yes li {
    color: var(--g-text);
  }

  .fit__col:not(.fit__col--yes) li {
    color: var(--g-text-muted);
  }

  .ico {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    margin-top: 0.2rem;
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ico--yes {
    stroke: var(--g-accent);
  }

  .ico--no {
    stroke: var(--g-text-subtle);
  }

  @media (max-width: 768px) {
    .fit {
      gap: var(--g-space-3);
      margin-top: var(--g-space-6);
    }

    .fit__col {
      padding: var(--g-space-5);
    }

    .fit__title {
      margin-bottom: var(--g-space-3);
    }

    .fit__list {
      gap: var(--g-space-3);
    }
  }
</style>
