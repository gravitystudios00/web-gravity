---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="container container--xl foot__inner">
    <p class="foot__brand">
      <Logo variant="icon" tone="yellow" height="1.4rem" />
      Studios
    </p>
    <nav class="foot__links" aria-label="Enlaces del pie">
      <a href="/contacto">Contacto</a>
      <a href="/legal">Legal</a>
    </nav>
    <p class="foot__copy">© {year} Gravity Studios</p>
  </div>
</footer>

<style>
  .foot {
    border-top: var(--g-border-width) solid var(--g-border);
    padding-block: var(--g-space-8);
    background: var(--g-bg-subtle);
  }

  .foot__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--g-space-4);
  }

  .foot__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--g-space-2);
    font-family: var(--g-font-display);
    font-weight: var(--g-weight-semibold);
    color: var(--g-text-strong);
  }

  .foot__links {
    display: flex;
    gap: var(--g-space-6);
  }

  .foot__links a {
    font-size: var(--g-text-sm);
    color: var(--g-text-muted);
    text-decoration: none;
    transition: color var(--g-duration-fast) var(--g-ease-out);
  }

  .foot__links a:hover {
    color: var(--g-text-accent);
  }

  .foot__copy {
    font-size: var(--g-text-sm);
    color: var(--g-text-subtle);
  }
</style>
