---
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Cases from './Cases.astro';
import Services from './Services.astro';
import About from './About.astro';
import Comparison from './Comparison.astro';
import Process from './Process.astro';
import Fit from './Fit.astro';
import Faq from './Faq.astro';
import Agenda from './Agenda.astro';
import FinalCta from './FinalCta.astro';
import Footer from './Footer.astro';
import FloatingWhatsApp from './FloatingWhatsApp.astro';
import type { Headline } from '../data/site';

interface Props {
  headline: Headline;
  /** Las variantes de ads muestran solo hero + calendario + comparación. */
  short?: boolean;
}

const { headline, short = false } = Astro.props;
---

<Nav />
<main>
  <Hero headline={headline} />
  {/* Prueba social antes del calendario: resumen de casos en tarjetas (el
      caso completo de Guille está en /casos/guillermo). */}
  {!short && <Cases />}
  {/* El calendario va acá arriba, en el lugar donde estaba el carrusel de
      reseñas: es lo primero que ve alguien que ya viene decidido del anuncio. */}
  <Agenda />
  {!short && <Services />}
  {/* Qué pasa después de agendar: los 90 días con los pilares de la oferta. */}
  {!short && <Process />}
  {!short && <About />}
  <Comparison />
  {!short && <Fit />}
  {/* Las objeciones de la Oferta Espejo, justo antes del último llamado. */}
  {!short && <Faq />}
  <FinalCta />
</main>
<Footer />
<FloatingWhatsApp />
