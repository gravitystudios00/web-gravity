---
import { LOGO_RATIOS } from '../data/logoRatios';

interface Props {
  /** 'full' = isotipo + wordmark. 'icon' = solo la G. */
  variant?: 'full' | 'icon';
  /**
   * Qué versión de color usar. Seguí la guía de marca:
   *   yellow → lockup primario, sobre fondo negro (nav, footer)
   *   black  → sobre fondos claros (la tarjeta crema del calendario)
   *   cream  → sobre fotografía o color rico
   */
  tone?: 'yellow' | 'black' | 'cream';
  /** Alto del logo. Por debajo de 1.5rem, usar variant="icon". */
  height?: string;
  class?: string;
}

const { variant = 'full', tone = 'yellow', height, class: className } = Astro.props;

const kind = variant === 'full' ? 'wordmark' : 'icon';
const key = `${kind}-${tone}` as keyof typeof LOGO_RATIOS;
const ratio = LOGO_RATIOS[key];
const h = height ?? (variant === 'full' ? '1.75rem' : '1.5rem');
---

<img
  src={`/brand/${key}.webp`}
  alt={variant === 'full' ? 'Gravity Studios' : ''}
  aria-hidden={variant === 'icon' ? 'true' : undefined}
  class:list={['g-logo', className]}
  style={`--g-logo-h:${h}; --g-logo-ratio:${ratio}`}
/>

<style>
  /* El ancho sale del `aspect-ratio`, no de un `calc()` sobre --g-logo-h.
     Con el calc, cualquier regla que pisara `height` (por ejemplo el tamaño
     reducido del nav en mobile) dejaba el ancho atado a la altura vieja y el
     logo salía estirado: ratio 5,55 en vez de 4,12. */
  .g-logo {
    display: block;
    height: var(--g-logo-h);
    width: auto;
    aspect-ratio: var(--g-logo-ratio);
    flex: none;
  }
</style>
