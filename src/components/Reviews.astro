---
import Stars from './Stars.astro';
import { reviews, type Review } from '../data/reviews';

interface Props {
  title?: string;
  /** Poner en false si no querés las estrellas. */
  stars?: boolean;
}

const { title = 'Lo que dicen las clínicas', stars = true } = Astro.props;

/* El array vive vacío hasta que se carguen las reseñas. Mientras tanto
   mostramos placeholders para que se vea el layout funcionando. */
const isEmpty = reviews.length === 0;

const placeholders: Review[] = Array.from({ length: 6 }, (_, i) => ({
  name: '—',
  role: 'Cargar en src/data/reviews.ts',
  rating: 0,
  text: `Reseña ${i + 1}. El componente está terminado: layout, loop, pausa al hover y swipe. Solo falta el contenido.`,
}));

const items = isEmpty ? placeholders : reviews;

/* El track se duplica para que el loop no tenga costura. La duración crece
   con la cantidad de tarjetas para que la velocidad se mantenga constante. */
const duration = Math.max(28, items.length * 7);
---

<section class="section" id="prueba-social">
  <div class="container container--xl">
    <h2 class="h2 center" data-reveal>{title}</h2>
  </div>

  <div
    class="marquee"
    data-reveal
    style={`--marquee-duration:${duration}s`}
    aria-label="Reseñas de clientes"
  >
    <div class="marquee__track">
      {
        [0, 1].map((copy) =>
          items.map((r) => (
            <article
              class:list={['review', 'surface', 'spot', 'lift', isEmpty && 'review--empty']}
              aria-hidden={copy === 1 ? 'true' : undefined}
            >
              <header class="review__head">
                {r.avatar ? (
                  <img class="review__avatar" src={r.avatar} alt="" loading="lazy" width="44" height="44" />
                ) : (
                  <span class="review__avatar review__avatar--initial" aria-hidden="true">
                    {r.name.trim().charAt(0)}
                  </span>
                )}
                <div class="review__who">
                  <p class="review__name">{r.name}</p>
                  <p class="review__role">{r.role}</p>
                </div>
              </header>

              {stars && (
                <div class="review__meta">
                  <Stars rating={r.rating} />
                  {r.date && <span class="review__date">{r.date}</span>}
                </div>
              )}

              <p class="review__text">{r.text}</p>
            </article>
          ))
        )
      }
    </div>
  </div>
</section>

<style>
  .marquee {
    margin-top: var(--g-space-10);
    overflow: hidden;
    /* Las tarjetas se desvanecen contra el fondo en los dos bordes en vez de
       cortarse en seco. */
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 6rem,
      #000 calc(100% - 6rem),
      transparent
    );
  }

  .marquee__track {
    display: flex;
    gap: var(--g-space-6);
    width: max-content;
    padding-inline: var(--g-space-6);
    animation: marquee var(--marquee-duration, 40s) linear infinite;
  }

  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      /* -50% = exactamente una copia del track. */
      transform: translateX(-50%);
    }
  }

  /* --- Tarjeta --------------------------------------------------------- */

  .review {
    display: flex;
    flex-direction: column;
    gap: var(--g-space-3);
    flex: 0 0 22rem;
    max-width: 22rem;
    padding: var(--g-space-6);
    border-radius: var(--g-radius-lg);
  }

  .review--empty {
    opacity: 0.45;
    border-style: dashed;
  }

  .review__head {
    display: flex;
    align-items: center;
    gap: var(--g-space-3);
  }

  .review__avatar {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--g-radius-full);
    object-fit: cover;
    flex: none;
    /* Anillo ámbar tenue, como el borde de un avatar verificado. */
    box-shadow:
      0 0 0 1px var(--g-accent-border),
      0 0 0 4px rgba(234, 190, 63, 0.07);
  }

  .review__avatar--initial {
    display: grid;
    place-items: center;
    background: var(--g-accent);
    color: var(--g-on-accent);
    font-family: var(--g-font-display);
    font-weight: var(--g-weight-semibold);
    font-size: var(--g-text-lg);
  }

  .review__who {
    min-width: 0;
  }

  .review__name {
    font-family: var(--g-font-display);
    font-weight: var(--g-weight-semibold);
    color: var(--g-text-strong);
    line-height: var(--g-leading-snug);
  }

  .review__role {
    font-size: var(--g-text-sm);
    color: var(--g-text-subtle);
    line-height: var(--g-leading-snug);
  }

  .review__meta {
    display: flex;
    align-items: center;
    gap: var(--g-space-3);
  }

  .review__date {
    font-size: var(--g-text-xs);
    color: var(--g-text-subtle);
  }

  .review__text {
    color: var(--g-text-muted);
    font-size: var(--g-text-sm);
    line-height: var(--g-leading-normal);
    text-wrap: pretty;
  }

  /* --- Touch: sin marquee, scroll nativo con snap ----------------------- */

  @media (hover: none) {
    .marquee {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      mask-image: none;
    }

    .marquee::-webkit-scrollbar {
      display: none;
    }

    .marquee__track {
      animation: none;
      width: auto;
    }

    .review {
      scroll-snap-align: center;
      flex-basis: 78vw;
      max-width: 20rem;
    }
  }
</style>

<script>
  /* En touch la segunda copia del track es ruido: la sacamos del DOM para no
     duplicar el scroll ni las imágenes. */
  if (window.matchMedia('(hover: none)').matches) {
    document
      .querySelectorAll('.marquee__track > [aria-hidden="true"]')
      .forEach((el) => el.remove());
  }
</script>
