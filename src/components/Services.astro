---
import { services } from '../data/site';

/*
 * Tarjeta 01: el clon de Caro, vertical, en loop y muteado; tocarlo abre el
 * video completo con sonido en un <dialog>.
 *
 * Tarjeta 02: la animación del bot (src/components/bot), que avanza con el
 * scroll y retrocede al subir. Mientras corre, algo queda fijo en pantalla:
 *   - teléfono: el video dentro de su tarjeta (.bot-runway → .bot-stage)
 *   - escritorio: la fila de tarjetas entera (.cards-runway → .cards), para
 *     no dejar dos columnas vacías al lado de una fija.
 */
---

<section class="section" id="que-hacemos">
  <div class="container">
    <div class="center stack" style="gap: var(--g-space-4)">
      <h2 class="h2" data-reveal>Qué hacemos</h2>
      <p class="lead" data-reveal style="--reveal-i:1">
        Las agencias de publicidad para clínicas solo traen mensajes, sin
        preocuparse por que realmente vendas ni por los procesos de agenda de tu
        clínica. Nosotros nos enfocamos en lo que nadie más se enfoca.
      </p>
    </div>

    <div class="cards-runway">
      <div class="cards">
        {
          services.map((s, i) => (
            <article class="card surface spot lift" data-reveal style={`--reveal-i:${i}`}>
              <span class="card__n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="h3">{s.title}</h3>
              <p class="muted">{s.text}</p>

              {s.media?.kind === 'video' && s.media.loop && (
                <button
                  type="button"
                  class="card__media card__vframe"
                  data-full={s.media.full || s.media.loop}
                  data-slug={s.media.slug}
                  aria-label={`${s.media.cta}: ${s.media.label}`}
                >
                  <video
                    src={s.media.loop}
                    poster={s.media.poster || undefined}
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-hidden="true"
                    tabindex="-1"
                  />
                  <span class="card__expand">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M11 5 6 9H2v6h4l5 4V5zM15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14" />
                    </svg>
                    {s.media.cta}
                  </span>
                </button>
              )}

              {s.media?.kind === 'bot' && (
                <div class="card__media bot-runway">
                  <div class="card__vframe bot-stage" role="img" aria-label={s.media.label}>
                    <div class="bot-mount" data-bot></div>
                  </div>
                </div>
              )}
            </article>
          ))
        }
      </div>
      <div class="cards-runway__spacer" aria-hidden="true"></div>
    </div>
  </div>

  <dialog class="vmodal" aria-label="Video">
    <div class="vmodal__frame">
      <button type="button" class="vmodal__close" aria-label="Cerrar video">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
      <video controls playsinline preload="none"></video>
    </div>
  </dialog>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--g-space-6);
    margin-top: var(--g-space-12);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--g-space-3);
    padding: var(--g-space-8);
    border-radius: var(--g-radius-xl);
  }

  /* Los tres pasos son una secuencia real (contenido → filtro → sistema),
     así que numerarlos dice algo. */
  .card__n {
    font-family: var(--g-font-display);
    font-size: var(--g-text-sm);
    font-weight: var(--g-weight-bold);
    letter-spacing: var(--g-tracking-wide);
    color: var(--g-accent);
  }

  .card p {
    line-height: var(--g-leading-normal);
    text-wrap: pretty;
  }

  .card:has(.card__media) p {
    margin-bottom: var(--g-space-2);
  }

  /* --- Marco vertical 9:16 (clon y bot) ------------------------------ */

  .card {
    /* Alto de los dos videos verticales. El ancho sale del 9:16. */
    --vframe-h: clamp(17rem, 50vh, 30rem);
  }

  .card__media {
    /* Abajo de todo: con las tarjetas a la misma altura en escritorio, los
       dos videos quedan alineados por la base. */
    margin-top: auto;
  }

  .card__vframe {
    position: relative;
    display: block;
    height: var(--vframe-h);
    aspect-ratio: 9 / 16;
    max-width: 100%;
    margin-inline: auto;
    padding: 0;
    border: 0;
    border-radius: var(--g-radius-lg);
    overflow: hidden;
    background: #000;
    box-shadow:
      0 0 0 1px var(--g-accent-border),
      var(--g-shadow-md);
  }

  button.card__vframe {
    cursor: zoom-in;
    transition: box-shadow var(--g-duration-base) var(--g-ease-out);
  }

  button.card__vframe:hover,
  button.card__vframe:focus-visible {
    box-shadow:
      0 0 0 1.5px var(--g-accent),
      var(--g-shadow-lg);
  }

  button.card__vframe:focus-visible {
    outline: 2px solid var(--g-accent);
    outline-offset: 3px;
  }

  .card__vframe video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card__expand {
    position: absolute;
    left: 50%;
    bottom: var(--g-space-3);
    translate: -50% 0;
    display: inline-flex;
    align-items: center;
    gap: var(--g-space-1);
    padding: var(--g-space-1) var(--g-space-3);
    border-radius: var(--g-radius-pill);
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(6px);
    color: var(--g-text-strong);
    font-family: var(--g-font-display);
    font-size: var(--g-text-xs);
    font-weight: var(--g-weight-semibold);
    white-space: nowrap;
    pointer-events: none;
  }

  .card__expand svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: var(--g-accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .bot-mount {
    position: absolute;
    inset: 0;
  }

  /* --- Scroll del bot -------------------------------------------------- */

  /* Escritorio: queda fija la fila de tarjetas mientras se recorre el spacer. */
  @media (min-width: 769px) {
    .cards {
      position: sticky;
      /* Debajo del nav fijo. */
      top: 5.5rem;
    }

    .cards-runway__spacer {
      height: var(--bot-scroll, 300vh);
    }
  }

  /* Teléfono: las tarjetas van apiladas, así que se fija solo el video. */
  @media (max-width: 768px) {
    .card {
      --vframe-h: 50svh;
    }

    .bot-runway {
      --vframe-h: 66svh;
      height: calc(var(--vframe-h) + var(--bot-scroll, 280svh));
    }

    .bot-stage {
      position: sticky;
      top: calc((100svh - var(--vframe-h)) / 2);
    }
  }

  /* --- Video completo ------------------------------------------------- */

  .vmodal {
    /* margin auto es lo que centra un <dialog>; el reset global lo pisa. */
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    max-width: none;
    max-height: none;
    overflow: visible;
  }

  .vmodal::backdrop {
    background: rgba(0, 0, 0, 0.86);
    backdrop-filter: blur(4px);
  }

  .vmodal__frame {
    position: relative;
    height: min(88dvh, calc(92vw * 16 / 9));
    aspect-ratio: 9 / 16;
    border-radius: var(--g-radius-lg);
    overflow: hidden;
    background: #000;
    box-shadow:
      0 0 0 1px var(--g-accent-border),
      var(--g-shadow-lg);
  }

  .vmodal video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .vmodal__close {
    position: absolute;
    top: var(--g-space-2);
    right: var(--g-space-2);
    z-index: 1;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.72);
    cursor: pointer;
  }

  .vmodal__close svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: var(--g-text-strong);
    stroke-width: 2.2;
    stroke-linecap: round;
  }

  .vmodal__close:focus-visible {
    outline: 2px solid var(--g-accent);
  }
</style>

<script>
  /* --- Clon: loop en la tarjeta + video completo al tocarlo ------------ */

  const tiles = document.querySelectorAll<HTMLButtonElement>('#que-hacemos button.card__vframe');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // El loop corre solo mientras se ve; con menos movimiento pedido queda el
  // poster fijo y el video se ve solo al abrirlo.
  if (!reduce) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target.querySelector('video')!;
          if (e.isIntersecting) {
            v.preload = 'auto';
            v.play().catch(() => {});
          } else {
            v.pause();
          }
        }
      },
      { threshold: 0.35 }
    );
    tiles.forEach((t) => io.observe(t));
  }

  const modal = document.querySelector<HTMLDialogElement>('#que-hacemos .vmodal')!;
  const player = modal.querySelector('video')!;

  tiles.forEach((t) =>
    t.addEventListener('click', () => {
      player.src = t.dataset.full!;
      player.poster = t.querySelector('video')!.poster;
      modal.showModal();
      player.play().catch(() => {});
      (window as any).gTrack?.('video_open', { source: t.dataset.slug });
    })
  );

  modal.querySelector('.vmodal__close')!.addEventListener('click', () => modal.close());
  // Clic en el fondo oscuro (fuera del video) también cierra.
  modal.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });
  modal.addEventListener('close', () => {
    player.pause();
    player.removeAttribute('src');
    player.load();
  });

  /* --- Bot: se monta cuando la tarjeta se acerca a la pantalla ---------- */

  const mount = document.querySelector<HTMLElement>('#que-hacemos [data-bot]');
  if (mount) {
    const phone = matchMedia('(max-width: 768px)');
    const getTrack = () =>
      phone.matches
        ? { runway: mount.closest<HTMLElement>('.bot-runway'), sticky: mount.closest<HTMLElement>('.bot-stage') }
        : {
            runway: mount.closest<HTMLElement>('.cards-runway'),
            sticky: mount.closest<HTMLElement>('.cards'),
          };

    const io = new IntersectionObserver(
      async ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        const { mountBot } = await import('./bot/mount.jsx');
        mountBot(mount, getTrack);
      },
      // Con margen, para que esté dibujado antes de que aparezca.
      { rootMargin: '800px 0px' }
    );
    io.observe(mount);
  }
</script>
