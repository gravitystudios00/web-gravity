---
import Logo from './Logo.astro';
import Vsl from './Vsl.astro';
import { videoPage, whatsapp, waLink } from '../data/site';

interface Props {
  /** A quién le llega el "VISTO". /video-t → Tomás, /video-j → Juan. */
  who: 'juan' | 'tomas';
}

const { who } = Astro.props;
const nombre = whatsapp[who].name;

/* Las dos páginas son la misma pantalla: solo cambia el destinatario del
   WhatsApp. Por eso vive acá y las páginas son dos archivos de tres líneas. */
const href = waLink(`video-${who[0]}`, who, videoPage.waText);
---

<main class="vp">
  <div class="vp__inner">
    <a class="vp__brand" href="/" aria-label="Gravity Studios — inicio">
      <Logo variant="icon" tone="yellow" height="3rem" />
    </a>

    <h1 class="vp__title">
      {
        videoPage.headline.map((p) =>
          p.accent ? <span class="accent">{p.text}</span> : <span>{p.text}</span>
        )
      }
    </h1>

    <p class="vp__intro">
      {
        videoPage.intro.map((p) =>
          p.accent ? <span class="accent">{p.text}</span> : <span>{p.text}</span>
        )
      }
    </p>

    <ul class="vp__points">
      {
        videoPage.points.map((t) => (
          <li>
            <span class="vp__tick" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5" /></svg>
            </span>
            <span>{t}</span>
          </li>
        ))
      }
    </ul>

    <p class="vp__urgency">
      {
        videoPage.urgency.map((p) =>
          p.accent ? <span class="accent">{p.text}</span> : <span>{p.text}</span>
        )
      }
    </p>

    <div class="vp__video">
      <Vsl kicker={null} />
    </div>

    <p class="vp__after">
      {
        videoPage.afterVideo.map((p) =>
          p.accent ? <span class="accent">{p.text}</span> : <span>{p.text}</span>
        )
      }
    </p>

    <a
      class="btn btn--primary btn--lg"
      href={href}
      target="_blank"
      rel="noopener"
      data-track={`whatsapp_click:video-${who[0]}`}
    >
      Enviar "Visto" a {nombre}
    </a>
  </div>
</main>

<style>
  .vp {
    min-height: 100vh;
    padding-block: clamp(var(--g-space-8), 5vw, var(--g-space-16));
    background: var(--g-bg);
  }

  .vp__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--g-space-6);
    width: 100%;
    max-width: 52rem;
    margin-inline: auto;
    padding-inline: var(--g-space-5);
  }

  .vp__brand {
    display: inline-flex;
  }

  .vp__title {
    font-size: clamp(var(--g-text-2xl), 3.6vw, var(--g-text-4xl));
    line-height: var(--g-leading-tight);
    color: var(--g-text-strong);
    text-wrap: balance;
    max-width: 24ch;
  }

  .vp__intro,
  .vp__urgency,
  .vp__after {
    font-size: var(--g-text-lg);
    color: var(--g-text);
    line-height: var(--g-leading-normal);
    text-wrap: pretty;
    max-width: 46ch;
  }

  /* Los puntos van alineados a la izquierda aunque el resto esté centrado:
     una lista centrada se vuelve difícil de escanear. */
  .vp__points {
    display: flex;
    flex-direction: column;
    gap: var(--g-space-4);
    list-style: none;
    padding: 0;
    text-align: left;
    max-width: 44rem;
  }

  .vp__points li {
    display: flex;
    align-items: flex-start;
    gap: var(--g-space-3);
    line-height: var(--g-leading-normal);
    text-wrap: pretty;
  }

  .vp__tick {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    margin-top: 0.15rem;
    border-radius: var(--g-radius-full);
    background: var(--g-accent);
    box-shadow: 0 0 12px rgba(234, 190, 63, 0.35);
  }

  .vp__tick svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: var(--g-on-accent);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .vp__video {
    width: 100%;
    margin-top: var(--g-space-2);
  }

  @media (max-width: 768px) {
    .vp__inner {
      gap: var(--g-space-5);
    }

    .vp__title {
      font-size: clamp(1.35rem, 6vw, 1.75rem);
    }

    .vp__intro,
    .vp__urgency,
    .vp__after {
      font-size: var(--g-text-md);
    }

    .vp__points {
      gap: var(--g-space-3);
    }
  }
</style>
