---
import { vsl } from '../data/site';

/**
 * Fachada del VSL: muestra el poster y recién al hacer clic inyecta el
 * <video>. Antes esto cargaba un iframe de YouTube (~700 KB de JS antes del
 * primer clic); ahora es el archivo propio, comprimido con
 * scripts/process-vsl.mjs, así que la fachada además evita que el navegador
 * empiece a descargar los MB del video en el primer paint.
 */

interface Props {
  /**
   * Texto arriba del video. En las páginas de post-agenda se pasa null:
   * ahí el titular ya dice que el video dura 4 minutos y repetirlo sobra.
   */
  kicker?: string | null;
}

const { kicker = vsl.kicker } = Astro.props;
---

<div class="vsl">
  {kicker && <p class="vsl__kicker">{kicker}</p>}
  <button
    class="vsl__frame"
    type="button"
    data-src={vsl.src}
    aria-label="Reproducir el video"
  >
    <img src={vsl.poster} alt="" width="1280" height="720" loading="eager" />
    <span class="vsl__play" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg>
    </span>
  </button>
</div>

<style>
  .vsl {
    display: flex;
    flex-direction: column;
    gap: var(--g-space-3);
    align-items: center;
    width: 100%;
  }

  .vsl__kicker {
    font-family: var(--g-font-display);
    font-size: var(--g-text-md);
    color: var(--g-text-muted);
  }

  .vsl__frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: var(--g-border-width) solid var(--g-border);
    border-radius: var(--g-radius-lg);
    overflow: hidden;
    background: var(--g-surface);
    box-shadow: var(--g-shadow-lg);
    cursor: pointer;
  }

  .vsl__frame img,
  .vsl__frame :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }

  .vsl__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 4.5rem;
    height: 4.5rem;
    display: grid;
    place-items: center;
    border-radius: var(--g-radius-full);
    background: var(--g-accent);
    box-shadow: var(--g-shadow-accent);
    transition:
      transform var(--g-duration-base) var(--g-ease-out),
      opacity var(--g-duration-base) var(--g-ease-out);
  }

  .vsl__frame:hover .vsl__play {
    transform: scale(1.08);
  }

  .vsl__play svg {
    width: 2rem;
    height: 2rem;
    fill: var(--g-on-accent);
    margin-left: 3px;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.vsl__frame').forEach((el) => {
    el.addEventListener(
      'click',
      () => {
        const video = document.createElement('video');
        video.src = el.dataset.src ?? '';
        video.controls = true;
        video.playsInline = true;
        video.autoplay = true;
        video.setAttribute('preload', 'auto');
        el.replaceChildren(video);
        // El play() ocurre en el mismo gesto de clic, así que el navegador
        // lo permite con sonido incluido (no es autoplay "silencioso").
        video.play().catch(() => {});

        if ((window as any).gtag)
          (window as any).gtag('event', 'vsl_play', { source: 'hero' });
        if ((window as any).fbq) (window as any).fbq('track', 'ViewContent');
      },
      { once: true }
    );
  });
</script>
