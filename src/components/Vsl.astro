---
import { vsl } from '../data/site';

/**
 * Fachada del VSL: muestra el poster y recién al hacer clic inyecta el iframe
 * de YouTube. Evita cargar ~700 KB de JS de YouTube en el primer paint y
 * elimina el autoplay bloqueado por el navegador que tiene el sitio actual.
 */
const poster =
  vsl.poster || `https://i.ytimg.com/vi/${vsl.youtubeId}/maxresdefault.jpg`;
---

<div class="vsl">
  <p class="vsl__kicker">{vsl.kicker}</p>
  <button
    class="vsl__frame"
    type="button"
    data-yt={vsl.youtubeId}
    aria-label="Reproducir el video"
  >
    <img src={poster} alt="" width="1280" height="720" loading="eager" />
    <span class="vsl__play" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg>
    </span>
  </button>
</div>

<style>
  .vsl {
    display: flex;
    flex-direction: column;
    gap: var(--g-space-3);
    align-items: center;
    width: 100%;
  }

  .vsl__kicker {
    font-family: var(--g-font-display);
    font-size: var(--g-text-md);
    color: var(--g-text-muted);
  }

  .vsl__frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: var(--g-border-width) solid var(--g-border);
    border-radius: var(--g-radius-lg);
    overflow: hidden;
    background: var(--g-surface);
    box-shadow: var(--g-shadow-lg);
    cursor: pointer;
  }

  .vsl__frame img,
  .vsl__frame :global(iframe) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }

  .vsl__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 4.5rem;
    height: 4.5rem;
    display: grid;
    place-items: center;
    border-radius: var(--g-radius-full);
    background: var(--g-accent);
    box-shadow: var(--g-shadow-accent);
    transition: transform var(--g-duration-base) var(--g-ease-out);
  }

  .vsl__frame:hover .vsl__play {
    transform: scale(1.08);
  }

  .vsl__play svg {
    width: 2rem;
    height: 2rem;
    fill: var(--g-on-accent);
    margin-left: 3px;
  }
</style>

<script>
  document.querySelectorAll('.vsl__frame').forEach((el) => {
    el.addEventListener(
      'click',
      () => {
        const id = (el as HTMLElement).dataset.yt;
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1&iv_load_policy=3`;
        iframe.allow =
          'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.title = 'Video de presentación de Gravity Studios';
        el.replaceChildren(iframe);
        if ((window as any).gtag)
          (window as any).gtag('event', 'vsl_play', { source: 'hero' });
        if ((window as any).fbq) (window as any).fbq('track', 'ViewContent');
      },
      { once: true }
    );
  });
</script>
