---
interface Props {
  values: number[];
  labels?: string[];
  id: string;
}

const { values, labels = [], id } = Astro.props;

const W = 300;
const H = 120;
const PAD = 6;

const max = Math.max(...values);
const min = Math.min(...values);
const span = max - min || 1;

const pts = values.map((v, i) => {
  const x = PAD + (i / (values.length - 1)) * (W - PAD * 2);
  const y = H - PAD - ((v - min) / span) * (H - PAD * 2);
  return [x, y] as const;
});

const line = pts.map(([x, y], i) => `${i ? 'L' : 'M'} ${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
const area = `${line} L ${W - PAD} ${H} L ${PAD} ${H} Z`;
---

<div class="area" data-chart>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Evolución">
    <defs>
      <linearGradient id={`line-${id}`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="var(--g-yellow-700)"></stop>
        <stop offset="60%" stop-color="var(--g-yellow-500)"></stop>
        <stop offset="100%" stop-color="var(--g-yellow-300)"></stop>
      </linearGradient>
      <linearGradient id={`fill-${id}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="rgba(234,190,63,0.28)"></stop>
        <stop offset="100%" stop-color="rgba(234,190,63,0)"></stop>
      </linearGradient>
    </defs>

    <path class="area__fill" d={area} fill={`url(#fill-${id})`}></path>
    <path
      class="area__line"
      d={line}
      fill="none"
      stroke={`url(#line-${id})`}
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      pathLength="1"
    ></path>
    <circle
      class="area__dot"
      cx={pts[pts.length - 1][0]}
      cy={pts[pts.length - 1][1]}
      r="4"
    ></circle>
  </svg>

  {
    labels.length === 2 && (
      <div class="area__labels">
        <span>{labels[0]}</span>
        <span>{labels[1]}</span>
      </div>
    )
  }
</div>

<style>
  .area svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .area__line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1400ms var(--g-ease-out);
    filter: drop-shadow(0 0 8px rgba(234, 190, 63, 0.3));
  }

  .area__fill,
  .area__dot {
    opacity: 0;
    transition: opacity var(--g-duration-slow) var(--g-ease-out) 700ms;
  }

  .area__dot {
    fill: var(--g-yellow-300);
    filter: drop-shadow(0 0 8px rgba(234, 190, 63, 0.8));
  }

  .area.is-drawn .area__line {
    stroke-dashoffset: 0;
  }

  .area.is-drawn .area__fill,
  .area.is-drawn .area__dot {
    opacity: 1;
  }

  .area__labels {
    display: flex;
    justify-content: space-between;
    margin-top: var(--g-space-2);
    font-size: var(--g-text-xs);
    color: var(--g-text-subtle);
  }

  @media (prefers-reduced-motion: reduce) {
    .area__line {
      stroke-dashoffset: 0;
      transition: none;
    }
    .area__fill,
    .area__dot {
      opacity: 1;
      transition: none;
    }
  }
</style>
