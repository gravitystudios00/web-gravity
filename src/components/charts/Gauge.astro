---
interface Props {
  percent: number;
  label?: string;
}

const { percent, label } = Astro.props;

/* Semicírculo de radio 80 centrado en (100,100). Largo del arco = π·80. */
const ARC = Math.PI * 80;
const offset = ARC * (1 - percent / 100);
---

<div class="gauge" data-chart>
  <svg viewBox="0 0 200 118" role="img" aria-label={label ?? `${percent}%`}>
    <defs>
      <linearGradient id={`g-grad-${percent}`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="var(--g-yellow-600)"></stop>
        <stop offset="55%" stop-color="var(--g-yellow-500)"></stop>
        <stop offset="100%" stop-color="var(--g-yellow-300)"></stop>
      </linearGradient>
    </defs>

    <path
      class="gauge__track"
      d="M 20 100 A 80 80 0 0 1 180 100"
      fill="none"
      stroke-width="16"
      stroke-linecap="round"
    ></path>

    <path
      class="gauge__fill"
      d="M 20 100 A 80 80 0 0 1 180 100"
      fill="none"
      stroke={`url(#g-grad-${percent})`}
      stroke-width="16"
      stroke-linecap="round"
      style={`--arc:${ARC}; --arc-offset:${offset}`}
    ></path>
  </svg>
</div>

<style>
  .gauge svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .gauge__track {
    stroke: var(--g-surface-raised);
  }

  .gauge__fill {
    stroke-dasharray: var(--arc);
    stroke-dashoffset: var(--arc);
    filter: drop-shadow(0 0 10px rgba(234, 190, 63, 0.35));
    transition: stroke-dashoffset 1200ms var(--g-ease-out);
  }

  .gauge.is-drawn .gauge__fill {
    stroke-dashoffset: var(--arc-offset);
  }

  @media (prefers-reduced-motion: reduce) {
    .gauge__fill {
      transition: none;
      stroke-dashoffset: var(--arc-offset);
    }
  }
</style>
