---
import '../styles/global.css';
import { site, analytics } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Las variantes /hl1…/hl5 no deben indexarse: son la misma página. */
  noindex?: boolean;
  /** false = sin GA4, Clarity ni Meta (la página de admin muestra datos de contactos). */
  tracking?: boolean;
}

const {
  title = site.title,
  description = site.description,
  // El sitio ya está publicado, así que por default se indexa.
  // Las variantes de headline lo pasan en true a mano: son casi idénticas a
  // la home y, indexadas, competirían contra ella por las mismas búsquedas.
  noindex = false,
  tracking = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gravity Studios" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(site.ogImage, site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(site.ogImage, site.url).href} />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <link rel="icon" href="/favicon-512.png" sizes="512x512" type="image/png" />

    {/* Las dos únicas fuentes que se ven en el primer viewport. */}
    <link
      rel="preload"
      href="/fonts/baloo-da-2-600-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-400-700-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Quién es el visitante. Los links del bot de WhatsApp traen un código
        del contacto y los UTM: ?cw=<código> desde Cleo en Chatwoot, ?mc=<id>
        en los links viejos de ManyChat. Se guardan en el navegador para que
        la persona siga identificada si navega o vuelve otro día. El código se
        borra de la barra de direcciones: si reenvía el link, el que lo abra
        no queda registrado como ella. Va antes de GA4 para pasarle el user_id. */}
    {/* Las páginas de administración no se registran en el panel. */}
    {!tracking && <script is:inline>window.gNoTrack = true;</script>}
    <script is:inline>
      (function () {
        var KEY = 'g_visitor';
        var q = new URLSearchParams(location.search);
        var v = {};
        try {
          v = JSON.parse(localStorage.getItem(KEY)) || {};
        } catch (e) {}
        var mc = q.get('mc');
        if (mc && /^\d{1,20}$/.test(mc)) v.mc = mc;
        var cw = q.get('cw');
        if (cw && /^[a-z0-9]{12}$/.test(cw)) v.cw = cw;
        // fbclid: el clic del anuncio de Meta. Con él se arma fbc (el formato
        // que pide la API de conversiones: fb.1.<momento del clic>.<fbclid>),
        // que el quiz de /plan le manda al Worker.
        var fbclid = q.get('fbclid');
        if (fbclid && fbclid !== v.fbclid) v.fbc = 'fb.1.' + Date.now() + '.' + fbclid;
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid'].forEach(
          function (k) {
            if (q.get(k)) v[k] = q.get(k);
          }
        );
        /* Panel propio de visitantes (worker/tracking.js):
           - vid: un id por navegador. Va en localStorage y en una cookie
             propia (1 año) para que el Worker lo lea en el quiz, el recurso
             y Calendly, y para recuperarlo si se borra el localStorage.
           - sid: la visita. Se renueva tras 30 minutos sin actividad.
           - first_*: con qué llegó la primera vez (no se pisa nunca). */
        var rid = function () {
          var abc = 'abcdefghijklmnopqrstuvwxyz0123456789';
          var b = new Uint8Array(16);
          if (window.crypto && crypto.getRandomValues) crypto.getRandomValues(b);
          else for (var i = 0; i < 16; i++) b[i] = Math.random() * 256;
          var s = '';
          for (var j = 0; j < 16; j++) s += abc[b[j] % 36];
          return s;
        };
        var ID = /^[a-z0-9]{16}$/;
        var vid = '';
        try {
          vid = localStorage.getItem('g_vid') || '';
        } catch (e) {}
        var nuevo = false;
        if (!ID.test(vid)) {
          var ck = document.cookie.match(/(?:^|;\s*)g_vid=([a-z0-9]{16})/);
          vid = ck ? ck[1] : rid();
          nuevo = !ck;
        }
        try {
          localStorage.setItem('g_vid', vid);
        } catch (e) {}
        document.cookie = 'g_vid=' + vid + '; Max-Age=31536000; Path=/; SameSite=Lax' + (location.protocol === 'https:' ? '; Secure' : '');
        v.vid = vid;

        // Referrer externo (de otro sitio), si hay.
        var ref = '';
        try {
          if (document.referrer && new URL(document.referrer).host !== location.host) ref = document.referrer.slice(0, 500);
        } catch (e) {}
        var ahora = Date.now();
        var ses = null;
        try {
          ses = JSON.parse(localStorage.getItem('g_sid') || 'null');
        } catch (e) {}
        // Visita nueva: pasaron 30 minutos, o llegó desde otro sitio con UTM nuevos.
        var conUtm = q.get('utm_source') || q.get('fbclid');
        // La visita es de este navegador (vid): si el vid cambió, es otra.
        if (!ses || !ID.test(ses.id || '') || ses.vid !== vid || ahora - ses.t > 30 * 60 * 1000 || (conUtm && ref)) {
          ses = {
            id: rid(),
            vid: vid,
            nueva: true,
            src: {
              s_source: q.get('utm_source') || (q.get('fbclid') ? 'meta' : ''),
              s_medium: q.get('utm_medium') || '',
              s_campaign: q.get('utm_campaign') || '',
              s_content: q.get('utm_content') || '',
              s_term: q.get('utm_term') || '',
              s_referrer: ref,
            },
          };
        } else ses.nueva = false;
        ses.t = ahora;
        try {
          localStorage.setItem('g_sid', JSON.stringify(ses));
        } catch (e) {}
        window.gSesion = ses;

        if (!v.first_at) {
          v.first_at = ahora;
          v.first_source = q.get('utm_source') || (q.get('fbclid') ? 'meta' : '');
          v.first_medium = q.get('utm_medium') || '';
          v.first_campaign = q.get('utm_campaign') || '';
          v.first_content = q.get('utm_content') || '';
          v.first_term = q.get('utm_term') || '';
          v.first_fbclid = q.get('fbclid') || '';
          v.first_referrer = ref;
          v.first_pagina = location.pathname;
          v.nuevo = nuevo;
        } else v.nuevo = false;

        try {
          localStorage.setItem(KEY, JSON.stringify(v));
        } catch (e) {}
        window.gVisitor = v;
        if (q.has('mc') || q.has('cw')) {
          q.delete('mc');
          q.delete('cw');
          var s = q.toString();
          history.replaceState(null, '', location.pathname + (s ? '?' + s : '') + location.hash);
        }
      })();
    </script>

    {/* GA4 */}
    {
      tracking && analytics.ga4 && (
        <script is:inline define:vars={{ id: analytics.ga4 }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          window.gtag = gtag;
          gtag('js', new Date());
          var uid = window.gVisitor.cw ? 'cw-' + window.gVisitor.cw : window.gVisitor.mc;
          gtag('config', id, uid ? { user_id: uid } : {});
          // La librería (175 KB) se pide recién cuando la página terminó de
          // cargar: antes le competía al poster del VSL en mobile. Los eventos
          // de antes quedan en dataLayer y se mandan cuando llega.
          addEventListener('load', function () {
            (window.requestIdleCallback || setTimeout)(function () {
              var s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
              document.head.appendChild(s);
            });
          });
        </script>
      )
    }

    {/* Microsoft Clarity. Con mc, la sesión queda a nombre del contacto de
        ManyChat: en Clarity se filtra por "Custom user ID". Los UTM también
        van como etiquetas, así se ven aunque la persona vuelva sin ellos en
        la URL (el filtro Tráfico de Clarity solo lee la URL de entrada). */}
    {
      tracking && analytics.clarity && (
        <script is:inline define:vars={{ cid: analytics.clarity }}>
          (function (c, l, a, r, i, t, y) {
            c[a] =
              c[a] ||
              function () {
                (c[a].q = c[a].q || []).push(arguments);
              };
            t = l.createElement(r);
            t.async = 1;
            t.src = 'https://www.clarity.ms/tag/' + i;
            y = l.getElementsByTagName(r)[0];
            y.parentNode.insertBefore(t, y);
          })(window, document, 'clarity', 'script', cid);
          var v = window.gVisitor;
          // Clarity guarda el ID hasheado; el 5º parámetro (nombre visible) es
          // lo que se lee en la lista de grabaciones.
          if (v.cw) {
            clarity('identify', v.cw, undefined, undefined, 'WhatsApp ' + v.cw);
            clarity('set', 'cw', v.cw);
          } else if (v.mc) {
            clarity('identify', v.mc, undefined, undefined, 'ManyChat ' + v.mc);
            clarity('set', 'mc', v.mc);
          }
          ['utm_source', 'utm_medium', 'utm_campaign'].forEach(function (k) {
            if (v[k]) clarity('set', k, v[k]);
          });
          // Para saltar del panel propio a las grabaciones de este visitante.
          if (v.vid) clarity('set', 'vid', v.vid);
        </script>
      )
    }

    {/* Un solo punto para registrar lo que hace el visitante: GA4, Clarity,
        Meta y, si viene del bot de WhatsApp, una etiqueta en su charla (el
        Worker en /api/mc la pasa a n8n → Chatwoot, o a ManyChat si es un link
        viejo). */}
    <script is:inline>
      /* Eventos de Meta de la landing. Los marcados con `capi` salen por el
         pixel y por la API de conversiones (Worker, /api/capi-web) con el mismo
         event_id: Meta junta los dos y lo cuenta una vez, y si el navegador
         bloquea el pixel igual llega el del servidor.
         Lead no está acá a propósito: es del quiz (/plan) y del recurso, que lo
         mandan ellos mismos. Así cada campaña se optimiza por lo suyo:
         quiz → Lead, landing → Schedule (o EligioHorario mientras haya pocas
         reservas). */
      window.gMetaEvents = {
        whatsapp_click: { type: 'track', name: 'Contact' },
        vsl_play: { type: 'track', name: 'ViewContent' },
        vsl_90: { type: 'trackCustom', name: 'VideoCompleto', capi: true },
        calendly_time: { type: 'trackCustom', name: 'EligioHorario', capi: true },
        calendly_booked: { type: 'track', name: 'Schedule', capi: true },
      };
      /* Manda un evento por el pixel con su event_id (para que Meta lo junte
         con el mismo evento mandado desde el servidor). */
      window.gPixel = function (type, name, props, eventId) {
        if (window.fbq) window.fbq(type, name, props || {}, { eventID: eventId });
      };
      window.gTrack = function (event, props, extra) {
        props = props || {};
        if (window.gtag) window.gtag('event', event, props);
        if (window.clarity) window.clarity('event', event);
        // Panel propio: todo evento queda registrado (ver el script de abajo).
        if (window.gLog) window.gLog(event, props);
        var m = window.gMetaEvents[event];
        // En /recurso el clic a WhatsApp ya lo manda el servidor como Contact.
        if (m && !(event === 'whatsapp_click' && location.pathname.indexOf('/recurso') === 0)) {
          var id = event + '-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8);
          window.gPixel(m.type, m.name, props, id);
          if (m.capi)
            fetch('/api/capi-web', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              keepalive: true,
              body: JSON.stringify({
                e: event,
                event_id: id,
                url: location.href.split('#')[0],
                cw: (window.gVisitor || {}).cw,
                vid: (window.gVisitor || {}).vid,
                invitee: extra && extra.invitee,
              }),
            }).catch(function () {});
        }
        var v = window.gVisitor || {};
        if ((v.cw || v.mc) && navigator.sendBeacon)
          navigator.sendBeacon('/api/mc', JSON.stringify({ cw: v.cw, mc: v.mc, e: event }));
      };

      /* Panel propio (worker/tracking.js): los eventos se juntan y se mandan
         en tandas a /api/t cada 10 segundos y al salir de la página. Es del
         mismo dominio, así que los bloqueadores no lo cortan. */
      (function () {
        if (window.gNoTrack) return;
        var cola = [];
        var enviar = function () {
          if (!cola.length) return;
          var v = window.gVisitor || {};
          var s = window.gSesion || {};
          while (cola.length) {
            var tanda = cola.splice(0, 25);
            var info = {
              utm_source: v.utm_source, utm_medium: v.utm_medium, utm_campaign: v.utm_campaign,
              utm_content: v.utm_content, utm_term: v.utm_term,
              first_source: v.first_source, first_medium: v.first_medium, first_campaign: v.first_campaign,
              first_content: v.first_content, first_term: v.first_term, first_fbclid: v.first_fbclid,
              first_referrer: v.first_referrer, first_pagina: v.first_pagina,
              cw: v.cw, mc: v.mc,
              idioma: navigator.language,
              pantalla: screen.width + 'x' + screen.height,
            };
            try {
              info.tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
            } catch (e) {}
            for (var k in s.src || {}) info[k] = s.src[k];
            var body = JSON.stringify({ vid: v.vid, sid: s.id, v: info, ev: tanda });
            var ok = navigator.sendBeacon && navigator.sendBeacon('/api/t', body);
            if (!ok)
              fetch('/api/t', { method: 'POST', body: body, keepalive: true, headers: { 'Content-Type': 'text/plain' } }).catch(
                function () {}
              );
          }
          // La visita sigue viva mientras haya actividad.
          try {
            s.t = Date.now();
            localStorage.setItem('g_sid', JSON.stringify({ id: s.id, vid: s.vid, t: s.t, src: s.src }));
          } catch (e) {}
        };
        window.gLog = function (evento, dato) {
          cola.push({ e: evento, t: Date.now(), p: location.pathname, d: dato && Object.keys(dato).length ? dato : undefined });
          if (cola.length >= 25) enviar();
        };
        window.gLogFlush = enviar;
        setInterval(enviar, 10000);
        addEventListener('pagehide', enviar);
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'hidden') enviar();
        });
      })();
    </script>

    {/* Meta Pixel — se activa solo cuando cargues el ID en src/data/site.ts */}
    {
      tracking && analytics.metaPixel && (
        <script is:inline define:vars={{ pid: analytics.metaPixel }}>
          !(function (f, b, e, v, n, t, s) {
            if (f.fbq) return;
            n = f.fbq = function () {
              n.callMethod
                ? n.callMethod.apply(n, arguments)
                : n.queue.push(arguments);
            };
            if (!f._fbq) f._fbq = n;
            n.push = n;
            n.loaded = !0;
            n.version = '2.0';
            n.queue = [];
            t = b.createElement(e);
            t.async = !0;
            t.src = v;
            s = b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t, s);
          })(
            window,
            document,
            'script',
            'https://connect.facebook.net/en_US/fbevents.js'
          );
          fbq('init', pid);
          fbq('track', 'PageView');
        </script>
      )
    }
  </head>

  <body data-clarity-unmask="true">
    {/* data-clarity-unmask: en modo "Balanced" Clarity tapa todos los números
        de las grabaciones (se veían como ▫▫ días, ▫▫▫%). El sitio no muestra
        datos de visitantes; los campos de texto Clarity los tapa siempre igual. */}
    <div class="grain" aria-hidden="true"></div>
    <slot />

    {/* Spotlight: el halo de las tarjetas sigue al cursor. Solo con mouse. */}
    <script is:inline>
      if (
        matchMedia('(hover: hover) and (pointer: fine)').matches &&
        !matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        let frame = 0;
        document.addEventListener(
          'pointermove',
          (e) => {
            if (frame) return;
            frame = requestAnimationFrame(() => {
              frame = 0;
              const card = e.target.closest('.spot');
              if (!card) return;
              const r = card.getBoundingClientRect();
              card.style.setProperty(
                '--spot-x',
                `${((e.clientX - r.left) / r.width) * 100}%`
              );
              card.style.setProperty(
                '--spot-y',
                `${((e.clientY - r.top) / r.height) * 100}%`
              );
            });
          },
          { passive: true }
        );
      }
    </script>

    {/* Los titulares marcados se revelan palabra por palabra. */}
    <script is:inline>
      document.querySelectorAll('.reveal-words').forEach((el) => {
        const walk = (node) => {
          [...node.childNodes].forEach((n) => {
            if (n.nodeType === 3) {
              const frag = document.createDocumentFragment();
              n.textContent.split(/(\s+)/).forEach((tok) => {
                if (!tok.trim()) return frag.appendChild(document.createTextNode(tok));
                const s = document.createElement('span');
                s.className = 'word';
                s.textContent = tok;
                frag.appendChild(s);
              });
              n.replaceWith(frag);
            } else if (n.nodeType === 1) {
              walk(n);
            }
          });
        };
        walk(el);
        el.querySelectorAll('.word').forEach((w, i) =>
          w.style.setProperty('--w', String(i))
        );
      });
    </script>

    {/* Reveal al entrar en viewport. Un solo observer para toda la página. */}
    <script is:inline>
      (() => {
        const els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.1 }
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>

    {/* Clics a WhatsApp, al calendario y a los casos (data-track="evento:origen"). */}
    <script is:inline>
      document.addEventListener('click', (e) => {
        const a = e.target.closest('a[data-track]');
        if (!a) return;
        const [event, source] = a.dataset.track.split(':');
        window.gTrack(event, { source });
      });
    </script>

    {/* Panel propio: entrada y salida de cada página (tiempo activo y scroll),
        qué secciones vio y en qué hizo clic. Solo va a /api/t (gLog), no a
        Analytics ni a Meta. */}
    <script is:inline>
      (function () {
        if (!window.gLog) return;
        var log = window.gLog;
        var v = window.gVisitor || {};
        var s = window.gSesion || {};

        log('page_view', {
          titulo: document.title.slice(0, 120),
          ref: (s.nueva && s.src && s.src.s_referrer) || undefined,
          nueva_visita: s.nueva || undefined,
          visitante_nuevo: v.nuevo || undefined,
          q: location.search.slice(0, 300) || undefined,
        });

        // Tiempo activo: solo cuenta con la pestaña visible.
        var activo = 0;
        var desde = document.visibilityState === 'visible' ? Date.now() : 0;
        var scrollMax = 0;
        var scrollEnviado = -1;
        var medirScroll = function () {
          var alto = document.documentElement.scrollHeight - innerHeight;
          var pct = alto > 0 ? Math.round((scrollY / alto) * 100) : 100;
          if (pct > scrollMax) scrollMax = Math.min(pct, 100);
        };
        addEventListener('scroll', medirScroll, { passive: true });
        medirScroll();
        var salir = function () {
          if (desde) activo += Date.now() - desde;
          desde = 0;
          var seg = Math.round(activo / 1000);
          // Se manda lo acumulado desde la última salida (al volver a la
          // pestaña sigue contando), así el total por página es la suma.
          if (seg > 0 || scrollMax > scrollEnviado) log('page_leave', { s: seg, scroll: scrollMax });
          scrollEnviado = scrollMax;
          activo = 0;
          if (window.gLogFlush) window.gLogFlush();
        };
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'hidden') salir();
          else desde = Date.now();
        });
        addEventListener('pagehide', salir);

        // Secciones vistas: al menos el 40 % en pantalla (o media pantalla
        // llena, para las secciones más altas que la pantalla). Una vez cada una.
        if ('IntersectionObserver' in window) {
          var vistas = {};
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                var id = e.target.id;
                if (!e.isIntersecting || vistas[id]) return;
                if (e.intersectionRatio >= 0.4 || e.intersectionRect.height >= innerHeight * 0.5) {
                  vistas[id] = 1;
                  log('section_view', { id: id });
                  io.unobserve(e.target);
                }
              });
            },
            { threshold: [0, 0.2, 0.4, 0.6] }
          );
          document.querySelectorAll('section[id]').forEach(function (el) {
            io.observe(el);
          });
        }

        // Clics en cualquier link o botón: texto y destino.
        document.addEventListener(
          'click',
          function (e) {
            var el = e.target.closest && e.target.closest('a, button');
            if (!el) return;
            var texto = (el.getAttribute('aria-label') || el.innerText || '').replace(/\s+/g, ' ').trim().slice(0, 60);
            var d = { texto: texto };
            if (el.tagName === 'A') {
              var href = el.getAttribute('href') || '';
              d.destino = href.slice(0, 200);
              d.tipo = /wa\.me|whatsapp/i.test(href)
                ? 'whatsapp'
                : /calendly/i.test(href)
                  ? 'calendly'
                  : href.charAt(0) === '#' || href.indexOf('/#') === 0
                    ? 'ancla'
                    : /^https?:/i.test(href) && el.host !== location.host
                      ? 'externo'
                      : 'interno';
            } else d.tipo = 'boton';
            if (el.id) d.id = el.id.slice(0, 40);
            log('click', d);
          },
          true
        );
      })();
    </script>
  </body>
</html>
