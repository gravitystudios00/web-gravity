{
  // Configuración del Worker que sirve el sitio.
  //
  // Cloudflare tiene el repo conectado por Git y, en cada push, corre
  // `astro build` y después `npx wrangler versions upload`. Ese comando
  // fallaba con "Missing entry-point to Worker script or to assets directory"
  // porque no encontraba este archivo: sin él, wrangler no sabe qué subir.
  //
  // Los archivos de dist/ se sirven directo desde la red de Cloudflare. El
  // único código de servidor es worker/index.js, que solo atiende /api/mc
  // (etiquetas del bot) y /api/lead (leads del quiz de /plan); todo lo demás
  // lo pasa a ASSETS.
  //
  // Secret necesario (no va en el repo):
  //   npx wrangler secret put MANYCHAT_API_KEY
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-gravity",
  "compatibility_date": "2026-08-22",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // API de conversiones de Meta (worker/meta.js: /api/capi del quiz y
  // /api/capi-web de la landing). Secrets: META_CAPI_TOKEN (token del conjunto
  // de datos) y CALENDLY_TOKEN (para leer las reservas del Schedule).
  "vars": {
    // Conjunto de datos "Gravity Pixel - 23/11" (portfolio Gravity Studios,
    // compartido con la cuenta publicitaria Gravity Studios 440300779171266).
    "META_PIXEL_ID": "4149392285331933",
    // Vacío en producción. Para probar: abrir "Probar eventos" en el
    // Administrador de eventos (origen: Sitio web), pegar el código que muestra
    // ahí, publicar, probar y volver a dejarlo vacío. Un código viejo no sirve:
    // Meta trata los eventos como prueba y no aparecen en ningún lado.
    "META_TEST_EVENT_CODE": "",
    // Recurso de /recurso (worker/recurso). Secrets: OPENAI_API_KEY y ADMIN_KEY.
    "OPENAI_MODEL": "gpt-6.1-terra",
    // Tope de generaciones por día para todo el sitio: si se llega, el recurso
    // pide volver mañana. Es la red de seguridad del gasto en OpenAI.
    "RECURSO_TOPE_DIARIO": "400",
    // Gasto máximo en OpenAI por médico (USD). Antes de cada generación se
    // suma lo gastado + lo máximo que puede costar la nueva: nunca se pasa.
    "RECURSO_TOPE_USD_USUARIO": "0.30"
  },
  // Base del recurso de /recurso (worker/recurso). Esquema en migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gravity-recurso",
      "database_id": "2648d9f7-c2a8-48c3-a044-e90b909d770e",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
