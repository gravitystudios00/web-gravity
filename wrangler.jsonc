{
  // Configuración del Worker que sirve el sitio.
  //
  // Cloudflare tiene el repo conectado por Git y, en cada push, corre
  // `astro build` y después `npx wrangler versions upload`. Ese comando
  // fallaba con "Missing entry-point to Worker script or to assets directory"
  // porque no encontraba este archivo: sin él, wrangler no sabe qué subir.
  //
  // Los archivos de dist/ se sirven directo desde la red de Cloudflare. El
  // único código de servidor es worker/index.js, que solo atiende /api/mc
  // (etiquetas del bot) y /api/lead (leads del quiz de /plan); todo lo demás
  // lo pasa a ASSETS.
  //
  // Secret necesario (no va en el repo):
  //   npx wrangler secret put MANYCHAT_API_KEY
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-gravity",
  "compatibility_date": "2026-08-22",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // API de conversiones de Meta (worker/index.js, /api/capi). El token va como
  // secret: npx wrangler secret put META_CAPI_TOKEN
  // META_TEST_EVENT_CODE: solo para probar en "Probar eventos"; dejarlo vacío.
  "vars": {
    // Conjunto de datos "Gravity Pixel - 23/11" (portfolio Gravity Studios,
    // compartido con la cuenta publicitaria Gravity Studios 440300779171266).
    "META_PIXEL_ID": "4149392285331933",
    "META_TEST_EVENT_CODE": "TEST34971"
  },
  "observability": {
    "enabled": true
  }
}
